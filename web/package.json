    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.21",
    "postcss": "^8.5.31",
    "typescript": "^5.8.0",
    "vite": "^8.3.0",
    "vite-css-modules": "^1.16.0"
  },
