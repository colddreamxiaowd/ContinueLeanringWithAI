{
  "name": "continue-learning-with-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:models": "node --test tests/*.test.mjs",
    "test:v3": "node --test tests/v3/*.test.mjs",
    "test:v45": "node --test tests/v45/*.test.mjs",
    "check:v45:static": "node scripts/check-v45-static.mjs",
    "test:library": "node --test tests/library/*.test.mjs",
