# Supabase public project settings (the publishable/anon key is intended for browser-facing auth).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only Supabase Secret Key (recommended; begins with sb_secret_).
# Never prefix with NEXT_PUBLIC_ or commit the real value.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SB_SECRET_KEY
# Legacy fallback is also supported: SUPABASE_SERVICE_ROLE_KEY=...

# Exact public website origin.
NEXT_PUBLIC_SITE_URL=https://YOUR_VERCEL_DOMAIN
# Must exactly match the redirect URL registered in Feishu Security Settings.
FEISHU_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/feishu/callback
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
# 32 random bytes as 64 hexadecimal characters; keep stable while saved tokens exist.
FEISHU_TOKEN_ENCRYPTION_KEY=64_HEX_CHARACTERS
